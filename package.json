{
  "name": "essay-grader",
  "version": "0.2.0",
  "private": true,
  "description": "紙本作文掃描、批閱、評分與回饋單輸出的桌機工具",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @essay-grader/desktop",
    "build": "npm run build -w @essay-grader/desktop",
    "start": "npm run start -w @essay-grader/desktop",
    "typecheck": "npm run typecheck -w @essay-grader/desktop",
    "validate:fixtures": "electron apps/desktop --validate-fixtures",
    "spike": "electron apps/desktop --spike",
    "m1:check": "electron apps/desktop --m1-check",
    "m2:check": "electron apps/desktop --m2-check",
    "m3:check": "electron apps/desktop --m3-check",
    "m4:check": "electron apps/desktop --m4-check",
    "m5:check": "electron apps/desktop --m5-check",
    "m6:check": "electron apps/desktop --m6-check",
    "m7:check": "electron apps/desktop --m7-check",
    "similarity:check": "electron apps/desktop --similarity-check",
    "drive:check": "electron apps/desktop --drive-check",
    "manifest:check": "electron apps/desktop --manifest-check",
    "excel:check": "electron apps/desktop --excel-check",
    "match:check": "electron apps/desktop --match-check",
    "batch:check": "electron apps/desktop --batch-check",
    "compare:check": "electron apps/desktop --compare-check",
    "praise:check": "electron apps/desktop --praise-check",
    "library-import:check": "electron apps/desktop --library-import-check",
    "junior:render": "node tools/render_junior_library.mjs",
    "junior:validate": "node tools/validate_junior_library.mjs",
    "junior:check": "node tools/validate_junior_library.mjs && node tools/validate_library_wording.mjs",
    "junior:readability": "node tools/validate_junior_readability.mjs",
    "library:wording": "node tools/validate_library_wording.mjs",
    "library:structure": "node tools/validate_library_structure.mjs",
    "library:coverage": "node tools/validate_comment_coverage.mjs",
    "library:short": "node tools/validate_library_short.mjs",
    "soak": "electron apps/desktop --soak",
    "android:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android.ps1 -Task \":app:testDebugUnitTest\"",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android.ps1 -Task \":app:assembleDebug\"",
    "m8:check": "npm run android:test && npm run android:build",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && npm run dist -w @essay-grader/desktop",
    "dist:portable": "npm run build && npm run dist:portable -w @essay-grader/desktop"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  }
}
