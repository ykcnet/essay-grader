{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@essay-grader/core/constants": ["../../packages/core/src/constants.ts"],
      "@essay-grader/core/review": ["../../packages/core/src/review.ts"],
      "@essay-grader/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/preload/**/*"]
}
