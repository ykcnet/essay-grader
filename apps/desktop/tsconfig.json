{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@essay-grader/core/constants": ["../../packages/core/src/constants.ts"],
      "@essay-grader/core/review": ["../../packages/core/src/review.ts"],
      "@essay-grader/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/preload/index.d.ts"]
}
