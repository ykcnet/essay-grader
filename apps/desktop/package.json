{
  "name": "@essay-grader/desktop",
  "version": "0.3.3",
  "private": true,
  "description": "Essay Grader 桌機批閱端（Electron）",
  "author": "Essay Grader",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "dist": "electron-builder --win --config electron-builder.yml",
    "dist:nsis": "electron-builder --win nsis --config electron-builder.yml",
    "dist:portable": "electron-builder --win portable --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "exceljs": "^4.4.0",
    "konva": "^10.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "sharp": "^0.34.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  }
}
